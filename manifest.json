{
  "id": "code-agent",
  "name": "Code Agent",
  "version": "0.1.3",
  "description": "调用本地 CLI 编码工具（Claude Code、OpenAI Codex）执行编码任务，实时展示执行细节",
  "trust": "full-access",
  "contributes": {
    "configuration": {
      "properties": {
        "defaultTool": {
          "type": "string",
          "enum": [
            "claude",
            "codex"
          ],
          "default": "claude",
          "description": "默认 CLI 工具"
        },
        "defaultModel": {
          "type": "string",
          "default": "sonnet",
          "description": "默认模型（如 sonnet、opus）"
        },
        "maxConcurrent": {
          "type": "number",
          "default": 3,
          "description": "最大并发任务数"
        },
        "defaultTimeout": {
          "type": "number",
          "default": 900,
          "description": "默认超时时间（秒）"
        }
      }
    }
  }
}
